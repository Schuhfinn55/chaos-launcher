{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chaos Launcher",
  "version": "2.1.11",
  "identifier": "de.chaoscraft.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Chaos Launcher",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/chaos-client.jar"
    ],
    "publisher": "ChaoscraftSMP",
    "copyright": "© 2026 ChaoscraftSMP – MIT License",
    "windows": {
      "timestampUrl": "http://timestamp.digicert.com",
      "digestAlgorithm": "sha256",
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "& (Join-Path (git rev-parse --show-toplevel) 'scripts/sign.ps1') -File '%1'"
        ]
      }
    }
  }
}
